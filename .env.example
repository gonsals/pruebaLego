# Tiendas oficiales de España (slugs separados por comas).
LEGO_STORES=barcelona

# Ejecuta npm run scan para consultar sin credenciales ni efectos externos.
EMAIL_ENABLED=true
GMAIL_USER=
# Contraseña de aplicación de Google; no la contraseña habitual de tu cuenta.
GMAIL_PASSWORD=
# Si se deja vacío se enviará a GMAIL_USER.
EMAIL_TO=

# Genera un secreto aleatorio y configúralo también en Vercel.
CRON_SECRET=

# Estado local. En Vercel conecta Upstash Redis y rellena las dos variables.
STATE_FILE=.data/state.json
STATE_KEY=lego-free-builds:v1
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# La integración de Vercel también puede proporcionar KV_REST_API_URL
# y KV_REST_API_TOKEN; la aplicación acepta esos nombres automáticamente.

# Opcional: creación automática de eventos. Los correos siempre incluyen
# un botón de Google Calendar y un archivo .ics si hay horario completo.
GOOGLE_CALENDAR_ENABLED=false
# Cliente OAuth de tipo Aplicación de escritorio, con Calendar API habilitada.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# npm run calendar:connect guarda este token directamente en .env.local.
GOOGLE_REFRESH_TOKEN=
# Es preferible usar un calendario dedicado, aunque primary también funciona.
GOOGLE_CALENDAR_ID=primary

# Alternativa sin Gmail ni OAuth: calendario para suscribirse desde una URL.
CALENDAR_FEED_ENABLED=false
# Genera un token aleatorio de 32 caracteres o más. Mantén privada la URL.
CALENDAR_FEED_TOKEN=
